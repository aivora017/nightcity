#!/usr/bin/env bash
# nc-sounds-gen — synthesize the nightcity UI sound set
set -euo pipefail
OUT="$HOME/nightcity/sounds"
mkdir -p "$OUT"
cd "$OUT"

# workspace switch: short mechanical relay click
sox -n ws.wav      synth 0.03 noise highpass 2500 lowpass 7000 fade 0 0.03 0.025 vol 0.35

# panel open / close: rising and falling blips
sox -n open.wav    synth 0.08 sine 620:1240 fade 0 0.08 0.06 vol 0.22
sox -n close.wav   synth 0.07 sine 1240:620 fade 0 0.07 0.05 vol 0.18

# notification: two soft ascending tones
sox -n t1.wav      synth 0.07 sine 880  fade 0.005 0.07 0.05 vol 0.25
sox -n t2.wav      synth 0.10 sine 1320 fade 0.005 0.10 0.08 vol 0.25
sox t1.wav t2.wav notify.wav
rm t1.wav t2.wav

# critical: three low pulses, clearly different from a normal notification
sox -n p.wav       synth 0.09 square 440 lowpass 1800 fade 0.005 0.09 0.04 vol 0.22
sox -n gap.wav     trim 0 0.06
sox p.wav gap.wav p.wav gap.wav p.wav alert.wav
rm p.wav gap.wav

# login: low hum that rises and fades
sox -n boot.wav    synth 1.4 sawtooth 45:110 lowpass 500 fade 0.15 1.4 0.9 vol 0.30

ls -l "$OUT"
