#!/usr/bin/env bash
# nc-shot — screenshots: region (default), full, window
set -uo pipefail

DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/$(date '+%Y-%m-%d_%H-%M-%S').png"

case "${1:-region}" in
  full)   grim "$FILE" ;;
  window) GEO=$(hyprctl activewindow -j | sed -n 's/.*"at": \[\([0-9-]*\),\([0-9-]*\)\].*/\1,\2/p' | head -1)
          SIZE=$(hyprctl activewindow -j | sed -n 's/.*"size": \[\([0-9]*\),\([0-9]*\)\].*/\1x\2/p' | head -1)
          grim -g "$GEO $SIZE" "$FILE" ;;
  *)      AREA=$(slurp) || exit 0            # Esc cancels, and that is not an error
          grim -g "$AREA" "$FILE" ;;
esac

if [[ -s "$FILE" ]]; then
  wl-copy < "$FILE"
  notify-send -i "$FILE" "Screenshot saved" "Copied to clipboard · $(basename "$FILE")"
else
  rm -f "$FILE"
fi
