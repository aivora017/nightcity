#!/usr/bin/env bash
# nc-wall-next — next wallpaper in order, or --random, or --prev
set -uo pipefail

DIR="${NC_WALLS:-$HOME/Pictures/walls}"
mapfile -t WALLS < <(find "$DIR" -maxdepth 1 -type f \
  \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | sort)

(( ${#WALLS[@]} == 0 )) && { notify-send "Wallpapers" "No images in $DIR"; exit 1; }

CUR="$(cat "$HOME/.cache/nightcity/wallpaper" 2>/dev/null)"
idx=-1
for i in "${!WALLS[@]}"; do [[ "${WALLS[$i]}" == "$CUR" ]] && idx=$i; done

case "${1:-}" in
  --random) n=$(( RANDOM % ${#WALLS[@]} ))
            (( ${#WALLS[@]} > 1 && n == idx )) && n=$(( (n + 1) % ${#WALLS[@]} )) ;;
  --prev)   n=$(( (idx - 1 + ${#WALLS[@]}) % ${#WALLS[@]} )) ;;
  *)        n=$(( (idx + 1) % ${#WALLS[@]} )) ;;
esac

exec "$HOME/.local/bin/nc-wall" "${WALLS[$n]}"
